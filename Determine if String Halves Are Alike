class Solution:
    def halvesAreAlike(self, s: str) -> bool:
        s=s.lower()
        n=len(s)
        s1=''
        s2=''
        a=n//2

        for i in range(0,a):
                s1+=s[i]

        for i in range(a,n):
                s2+=s[i]
        c1=0
        c2=0
        for i in s1:
            if i=='a' or i=='e' or i=='i'or i=='o' or i=='u':
                c1+=1
        for i in s2:
            if i=='a' or i=='e' or i=='i'or i=='o' or i=='u':
                c2+=1

        print(c1,c2)
        if c1==c2:
            return True
        return False


        
